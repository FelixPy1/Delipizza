# Renombra este archivo a .env y configura tu cadena de conexión

# Para SQL Server local usando autenticación de Windows:
DATABASE_URI="mssql+pyodbc://@TU_SERVIDOR/DeliPizza?driver=ODBC+Driver+17+for+SQL+Server"

# Para SQL Server con usuario y contraseña:
# DATABASE_URI="mssql+pyodbc://usuario:contraseña@TU_SERVIDOR/DeliPizza?driver=ODBC+Driver+17+for+SQL+Server"

# Para usar una base de datos local SQLite temporalmente mientras configuras SQL Server (descomentar):
# DATABASE_URI="sqlite:///delipizza.db"
